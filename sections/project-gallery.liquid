{% comment %}
  Project gallery — a responsive grid of finished-project photos. Each photo is a
  block with its own image, caption and SEO alt text. Photos tagged with a
  category render a small category chip. Designed so the merchant just picks an
  image for each pre-labeled block in the theme editor.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: '#C42A20'
-%}

<div
  class="rb-gallery section spacing-style"
  style="
    --rb-accent: {{ accent }};
    {% if section.settings.background_color != blank %}--color-background: {{ section.settings.background_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="rb-section__head">
        {%- if section.settings.eyebrow != blank -%}<p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="rb-section__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="rb-section__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <scroll-reveal class="rb-gallery__grid" data-reveal-stagger="60">
      {%- for block in section.blocks -%}
        {%- liquid
          assign alt = block.settings.alt | default: block.settings.caption | default: 'Concrete project by Rubio Brothers in Utah County'
          assign full = ''
          if block.settings.image != blank
            assign full = block.settings.image | image_url: width: 2000
          endif
        -%}
        <figure
          class="rb-gallery__tile{% if full == blank %} rb-gallery__tile--empty{% endif %}"
          data-reveal
          {% if full != blank %}data-full="{{ full }}" data-caption="{{ block.settings.caption | escape }}" role="button" tabindex="0" aria-label="Enlarge: {{ alt | escape }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw',
                widths: '400, 600, 800, 1200',
                alt: alt,
                class: 'rb-gallery__img'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'rb-gallery__placeholder' }}
          {%- endif -%}
          {%- if full != blank -%}<span class="rb-gallery__zoom" aria-hidden="true">⤢</span>{%- endif -%}
          {%- if block.settings.caption != blank or block.settings.category != blank -%}
            <figcaption class="rb-gallery__caption">
              {%- if block.settings.category != blank -%}<span class="rb-gallery__chip">{{ block.settings.category }}</span>{%- endif -%}
              {%- if block.settings.caption != blank -%}<span class="rb-gallery__cap-text">{{ block.settings.caption }}</span>{%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </scroll-reveal>

    <dialog class="rb-gallery__lightbox" aria-label="Project photo">
      <button type="button" class="rb-gallery__lightbox-close" aria-label="Close">&times;</button>
      <img class="rb-gallery__lightbox-img" alt="" width="1600" height="1200" />
      <p class="rb-gallery__lightbox-cap"></p>
    </dialog>

    <script>
      (() => {
        var root = document.currentScript.closest('.rb-gallery');
        if (!root) return;
        var dialog = root.querySelector('.rb-gallery__lightbox');
        var img = root.querySelector('.rb-gallery__lightbox-img');
        var cap = root.querySelector('.rb-gallery__lightbox-cap');
        if (!dialog || typeof dialog.showModal !== 'function') return;
        function open(tile) {
          img.src = tile.getAttribute('data-full');
          img.alt = (tile.getAttribute('aria-label') || '').replace(/^Enlarge:\s*/, '');
          cap.textContent = tile.getAttribute('data-caption') || '';
          dialog.showModal();
        }
        root.addEventListener('click', function (e) {
          var tile = e.target.closest('.rb-gallery__tile[data-full]');
          if (tile) { open(tile); return; }
          if (e.target.closest('.rb-gallery__lightbox-close') || e.target === dialog) dialog.close();
        });
        root.addEventListener('keydown', function (e) {
          var tile = e.target.closest && e.target.closest('.rb-gallery__tile[data-full]');
          if (tile && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(tile); }
        });
      })();
    </script>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="rb-gallery__cta">
        <a class="rb-gallery__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rb-gallery { background: var(--color-background); color: var(--color-foreground); }

  /* Masonry mosaic — uncropped photos at natural aspect ratios */
  .rb-gallery__grid {
    columns: 2;
    column-gap: var(--gap-sm, 0.75rem);
  }
  @media screen and (min-width: 600px) {
    .rb-gallery__grid { columns: 3; column-gap: var(--gap-md, 1rem); }
  }
  @media screen and (min-width: 990px) {
    .rb-gallery__grid { columns: 4; }
  }

  .rb-gallery__tile {
    position: relative;
    display: block;
    break-inside: avoid;
    margin: 0 0 var(--gap-sm, 0.75rem);
    overflow: hidden;
    border-radius: var(--card-corner-radius, 8px);
    background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }
  .rb-gallery__tile[data-full] { cursor: zoom-in; }
  .rb-gallery__tile[data-full]:focus-visible {
    outline: 3px solid var(--rb-accent, #C42A20);
    outline-offset: 2px;
  }
  @media screen and (min-width: 600px) {
    .rb-gallery__tile { margin-bottom: var(--gap-md, 1rem); }
  }

  .rb-gallery__tile--empty { aspect-ratio: 4 / 3; }

  .rb-gallery__img,
  .rb-gallery__placeholder {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .rb-gallery__tile--empty .rb-gallery__placeholder { height: 100%; }
  .rb-gallery__tile:hover .rb-gallery__img { transform: scale(1.05); }

  /* Zoom affordance */
  .rb-gallery__zoom {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.45);
    color: #fff;
    font-size: 1rem;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .rb-gallery__tile:hover .rb-gallery__zoom,
  .rb-gallery__tile:focus-visible .rb-gallery__zoom { opacity: 1; }

  /* Lightbox */
  .rb-gallery__lightbox {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 92vw;
    max-height: 92vh;
    overflow: visible;
  }
  .rb-gallery__lightbox::backdrop {
    background: rgb(0 0 0 / 0.82);
    backdrop-filter: blur(2px);
  }
  .rb-gallery__lightbox-img {
    max-width: 92vw;
    max-height: 84vh;
    width: auto;
    height: auto;
    display: block;
    margin: 0 auto;
    border-radius: 8px;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8);
  }
  .rb-gallery__lightbox-cap {
    color: #fff;
    text-align: center;
    margin: 0.7rem 0 0;
    font-weight: 600;
  }
  .rb-gallery__lightbox-close {
    position: fixed;
    top: 1rem;
    right: 1.2rem;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.16);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .rb-gallery__lightbox-close:hover { background: var(--rb-accent, #C42A20); }

  .rb-gallery__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--gap-sm, 0.75rem);
    color: #fff;
    background: linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0));
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .rb-gallery__tile:hover .rb-gallery__caption,
  .rb-gallery__tile:focus-within .rb-gallery__caption { opacity: 1; transform: none; }

  .rb-gallery__chip {
    align-self: flex-start;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--rb-accent);
  }
  .rb-gallery__cap-text { font-size: 0.85rem; line-height: 1.3; }

  @media (prefers-reduced-motion: reduce) {
    .rb-gallery__caption { opacity: 1; transform: none; }
  }

  .rb-gallery__cta { text-align: center; margin-top: var(--gap-xl); }
  .rb-gallery__btn {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: var(--rb-accent);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .rb-gallery__btn:hover { transform: translateY(-2px); opacity: 0.92; }
{% endstylesheet %}

{% schema %}
{
  "name": "Project gallery",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recent pours across Utah County" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "A look at driveways, patios, RV pads and decorative concrete we've poured for neighbors in Pleasant Grove, Lehi, American Fork, Orem and Provo." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C42A20" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "category", "label": "Category chip", "info": "e.g. Driveway, Stamped patio, RV pad" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "text", "id": "alt", "label": "Alt text (SEO)", "info": "Describe the photo + city, e.g. 'Stamped concrete patio in Orem, UT'." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Project gallery",
      "blocks": [
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" },
        { "type": "photo" }, { "type": "photo" }, { "type": "photo" }, { "type": "photo" }
      ]
    }
  ]
}
{% endschema %}
