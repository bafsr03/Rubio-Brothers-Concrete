{% comment %}
  Local area — the body of a city landing page. Prose about pouring in one
  specific town, the neighborhoods we work in, and the local conditions that
  change how a slab gets built there.

  The point of the copy blocks is that they are *different* per city. A set of
  city pages that say the same thing with the town name swapped is a doorway
  page, and Google treats it as one — so every block here is free text with no
  templated default to fall back on.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: '#C42A20'
  assign neighborhoods = section.settings.neighborhoods | split: ','
-%}

<div
  class="rb-local section spacing-style"
  style="
    --rb-accent: {{ accent }};
    {% if section.settings.background_color != blank %}--color-background: {{ section.settings.background_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="page-width">
    <div class="rb-local__layout">
      <div class="rb-local__main">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="rb-section__head">
            {%- if section.settings.eyebrow != blank -%}<p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="rb-section__title">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        <scroll-reveal class="rb-local__body" data-reveal-stagger="70">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'paragraph' -%}
                <div class="rb-local__prose" data-reveal {{ block.shopify_attributes }}>
                  {%- if block.settings.subheading != blank -%}
                    <h3 class="rb-local__subhead">{{ block.settings.subheading }}</h3>
                  {%- endif -%}
                  {{ block.settings.text }}
                </div>
              {%- when 'detail' -%}
                <div class="rb-local__detail" data-reveal {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h3 class="rb-local__detail-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="rb-local__detail-text">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </scroll-reveal>
      </div>

      {%- if section.settings.image != blank or neighborhoods.size > 0 -%}
        <aside class="rb-local__aside">
          {%- if section.settings.image != blank -%}
            <figure class="rb-local__figure">
              {{
                section.settings.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '400, 600, 800, 1000',
                  alt: section.settings.image_alt | default: section.settings.heading,
                  class: 'rb-local__img'
              }}
              {%- if section.settings.image_caption != blank -%}
                <figcaption class="rb-local__figcap">{{ section.settings.image_caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}

          {%- if neighborhoods.size > 0 -%}
            <div class="rb-local__hoods">
              {%- if section.settings.neighborhoods_title != blank -%}
                <h3 class="rb-local__hoods-title">{{ section.settings.neighborhoods_title }}</h3>
              {%- endif -%}
              <ul class="rb-local__hoods-list">
                {%- for hood in neighborhoods -%}
                  <li>{{ hood | strip }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .rb-local { background: var(--color-background); color: var(--color-foreground); }

  .rb-local__layout { display: grid; gap: var(--gap-lg, 2rem); }
  @media screen and (min-width: 990px) {
    .rb-local__layout { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: var(--gap-xl, 3rem); }
  }

  .rb-local__body { display: flex; flex-direction: column; gap: var(--gap-md, 1.25rem); }

  .rb-local__prose { max-width: 68ch; }
  .rb-local__prose p { margin: 0 0 0.85rem; line-height: 1.65; }
  .rb-local__prose p:last-child { margin-bottom: 0; }
  .rb-local__prose a { color: var(--rb-accent, #C42A20); }
  .rb-local__subhead { margin: 0 0 0.5rem; font-size: 1.15rem; line-height: 1.3; }

  .rb-local__detail {
    padding: var(--gap-sm, 0.9rem) 0 var(--gap-sm, 0.9rem) var(--gap-sm, 0.9rem);
    border-inline-start: 3px solid var(--rb-accent, #C42A20);
    background: color-mix(in srgb, var(--color-foreground) 4%, var(--color-background));
    border-radius: 0 var(--card-corner-radius, 8px) var(--card-corner-radius, 8px) 0;
  }
  .rb-local__detail-title { margin: 0 0 0.3rem; font-size: 1rem; line-height: 1.3; }
  .rb-local__detail-text { margin: 0; font-size: 0.9rem; line-height: 1.55; opacity: 0.85; }

  .rb-local__aside { display: flex; flex-direction: column; gap: var(--gap-md, 1.25rem); }

  .rb-local__figure { margin: 0; }
  .rb-local__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--card-corner-radius, 8px);
  }
  .rb-local__figcap { margin: 0.5rem 0 0; font-size: 0.8rem; opacity: 0.75; line-height: 1.4; }

  .rb-local__hoods {
    padding: var(--gap-md, 1.1rem);
    border-radius: var(--card-corner-radius, 8px);
    background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }
  .rb-local__hoods-title { margin: 0 0 0.6rem; font-size: 0.95rem; line-height: 1.3; }
  .rb-local__hoods-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.82rem;
  }
  .rb-local__hoods-list li {
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--color-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Local area",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "A real job from this town, not a stock photo." },
    { "type": "text", "id": "image_alt", "label": "Photo alt text (SEO)" },
    { "type": "text", "id": "image_caption", "label": "Photo caption" },
    { "type": "text", "id": "neighborhoods_title", "label": "Neighborhood list title", "default": "Neighborhoods we pour in" },
    { "type": "textarea", "id": "neighborhoods", "label": "Neighborhoods (comma separated)", "info": "Only list places you've actually worked. An invented list is easy to spot and hard to defend." },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C42A20" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Paragraph",
      "settings": [
        { "type": "text", "id": "subheading", "label": "Subheading (H3)" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "detail",
      "name": "Local detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Local area",
      "blocks": [{ "type": "paragraph" }, { "type": "detail" }, { "type": "detail" }]
    }
  ]
}
{% endschema %}
