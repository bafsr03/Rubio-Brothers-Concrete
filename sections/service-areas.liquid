{% comment %}
  Service areas — a grid of the towns we pour in, each linking to its own city
  page. This is the crawl path to those pages: a city page with no internal
  link pointing at it is a page Google has little reason to visit or trust, so
  this section is what makes the city pages worth having.

  Towns without a page of their own can still be listed as plain chips, so the
  full service area reads honestly without inventing thin pages for every name.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: '#C42A20'
  assign extra_areas = section.settings.other_areas | split: ','
-%}

<div
  class="rb-areas section spacing-style"
  style="
    --rb-accent: {{ accent }};
    {% if section.settings.background_color != blank %}--color-background: {{ section.settings.background_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="rb-section__head">
        {%- if section.settings.eyebrow != blank -%}<p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- assign heading_tag = section.settings.heading_level | default: 'h2' -%}
          <{{ heading_tag }} class="rb-section__title">{{ section.settings.heading }}</{{ heading_tag }}>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="rb-section__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <scroll-reveal class="rb-areas__grid" data-reveal-stagger="60">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <{{ tag }}
            class="rb-area-card"
            data-reveal
            {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              <div class="rb-area-card__media">
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw',
                    widths: '300, 500, 800',
                    alt: block.settings.image_alt | default: block.settings.title,
                    class: 'rb-area-card__img'
                }}
              </div>
            {%- endif -%}
            <div class="rb-area-card__body">
              {%- if block.settings.title != blank -%}
                <h3 class="rb-area-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="rb-area-card__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.link != blank and block.settings.link_label != blank -%}
                <span class="rb-area-card__cta">{{ block.settings.link_label }}</span>
              {%- endif -%}
            </div>
          </{{ tag }}>
        {%- endfor -%}
      </scroll-reveal>
    {%- endif -%}

    {%- if extra_areas.size > 0 -%}
      <p class="rb-areas__more">
        {%- if section.settings.other_areas_label != blank -%}
          <span class="rb-areas__more-label">{{ section.settings.other_areas_label }}</span>
        {%- endif -%}
        {%- for area in extra_areas -%}
          <span class="rb-areas__chip">{{ area | strip }}</span>
        {%- endfor -%}
      </p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rb-areas { background: var(--color-background); color: var(--color-foreground); }

  .rb-areas__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-sm, 0.75rem);
  }
  @media screen and (min-width: 750px) {
    .rb-areas__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap-md, 1rem); }
  }
  @media screen and (min-width: 990px) {
    .rb-areas__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .rb-area-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    border-radius: var(--card-corner-radius, 8px);
    background: color-mix(in srgb, var(--color-foreground) 5%, var(--color-background));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a.rb-area-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px -22px rgb(0 0 0 / 0.55);
  }
  a.rb-area-card:focus-visible {
    outline: 3px solid var(--rb-accent, #C42A20);
    outline-offset: 2px;
  }

  .rb-area-card__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .rb-area-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  a.rb-area-card:hover .rb-area-card__img { transform: scale(1.05); }

  .rb-area-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--gap-sm, 0.85rem);
  }
  .rb-area-card__title { margin: 0; font-size: 1.05rem; line-height: 1.25; }
  .rb-area-card__text { margin: 0; font-size: 0.85rem; line-height: 1.45; opacity: 0.8; }
  .rb-area-card__cta {
    margin-top: 0.2rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--rb-accent, #C42A20);
  }
  a.rb-area-card:hover .rb-area-card__cta { text-decoration: underline; }

  .rb-areas__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: var(--gap-md, 1.25rem) 0 0;
    font-size: 0.85rem;
  }
  .rb-areas__more-label { font-weight: 700; margin-inline-end: 0.2rem; }
  .rb-areas__chip {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background));
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-area-card, .rb-area-card__img { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Service areas",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Where we pour" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Concrete contractors serving Utah County" },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use H1 only on a page with no hero above this section. Every page needs exactly one H1.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We're based in Pleasant Grove and pour across northern Utah County. Pick your town to see the work we've done nearby." },
    { "type": "text", "id": "other_areas_label", "label": "Label before the extra towns", "default": "Also serving:" },
    { "type": "text", "id": "other_areas", "label": "Other towns (comma separated)", "info": "Listed as plain text, with no page of their own." },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C42A20" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "area",
      "name": "Town",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Use a real job from this town." },
        { "type": "text", "id": "image_alt", "label": "Photo alt text (SEO)" },
        { "type": "text", "id": "title", "label": "Town", "default": "Alpine, UT" },
        { "type": "text", "id": "text", "label": "One line" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "See our work" },
        { "type": "url", "id": "link", "label": "Link to the town's page" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service areas",
      "blocks": [{ "type": "area" }, { "type": "area" }, { "type": "area" }, { "type": "area" }]
    }
  ]
}
{% endschema %}
