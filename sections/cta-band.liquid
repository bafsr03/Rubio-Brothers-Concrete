{% comment %}
  CTA band — a bold, full-width conversion strip with a headline and up to two
  buttons (primary "Get a free estimate" + secondary tap-to-call).
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.foreground
  assign bg = section.settings.background_color | default: settings.color_palette.foreground
  assign fg = section.settings.text_color | default: settings.color_palette.background
-%}

<div
  class="rb-cta section spacing-style"
  style="
    --rb-accent: {{ accent }};
    --color-background: {{ bg }};
    --color-foreground: {{ fg }};
    background-color: {{ bg }};
    color: {{ fg }};
    {% render 'spacing-style', settings: section.settings %}
  "
>
  {%- if section.settings.image != blank -%}
    <div class="rb-cta__bg" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'lazy',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2400',
          alt: '',
          class: 'rb-cta__bg-img'
      }}
    </div>
  {%- endif -%}

  <scroll-reveal class="page-width rb-cta__inner">
    <div data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="rb-cta__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="rb-cta__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="rb-cta__actions" data-reveal>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="rb-cta__btn rb-cta__btn--primary" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a class="rb-cta__btn rb-cta__btn--secondary" href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">
          {{ section.settings.phone_label | default: section.settings.phone }}
        </a>
      {%- endif -%}
    </div>
  </scroll-reveal>
</div>

{% stylesheet %}
  .rb-cta {
    position: relative;
    overflow: hidden;
    background: var(--color-background);
    color: var(--color-foreground);
    isolation: isolate;
  }

  .rb-cta__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .rb-cta__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
  }

  .rb-cta__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    align-items: center;
    text-align: center;
  }

  .rb-cta__title {
    margin: 0 0 var(--gap-2xs);
    max-width: 20ch;
  }

  .rb-cta__text {
    margin: 0;
    max-width: 52ch;
    opacity: 0.9;
  }

  .rb-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-sm);
    justify-content: center;
  }

  .rb-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--padding-lg) var(--padding-2xl);
    border-radius: var(--button-border-radius-primary, 14px);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .rb-cta__btn:hover {
    transform: translateY(-2px);
  }

  .rb-cta__btn--primary {
    background: var(--rb-accent);
    color: var(--color-background);
  }

  .rb-cta__btn--secondary {
    background: transparent;
    color: var(--color-foreground);
    border: 2px solid currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Free, no-pressure quotes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to pour? Let's get your quote."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us about your project and we'll get you an exact price after a quick site visit — at no cost."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get a free estimate"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone button label",
      "default": "Call (385) 210-5983"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(385) 210-5983"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / button color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "CTA band"
    }
  ]
}
{% endschema %}
