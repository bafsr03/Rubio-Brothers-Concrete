{% comment %}
  Site hero — the headline conversion moment. Large headline, supporting copy,
  dual CTA (estimate + tap-to-call), trust chips, and an optional background
  image/video with a concrete-texture overlay.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.foreground
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
  assign chips = section.settings.trust_chips | newline_to_br | split: '<br />'
-%}

<div
  class="rb-hero spacing-style"
  style="
    --rb-accent: {{ accent }};
    --rb-overlay: {{ overlay }};
    --rb-hero-text: {{ section.settings.text_color | default: '#ffffff' }};
    --rb-hero-min-h: {{ section.settings.min_height }}svh;
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="rb-hero__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '800, 1200, 1600, 2000, 3000',
          alt: '',
          class: 'rb-hero__img'
      }}
    {%- else -%}
      <div class="rb-hero__anim">
        <span class="rb-hero__aurora"></span>
        <span class="rb-hero__grid"></span>
        <span class="rb-hero__spotlight"></span>
      </div>
    {%- endif -%}
    <div class="rb-hero__overlay"></div>
  </div>

  <scroll-reveal class="page-width rb-hero__inner" data-reveal-stagger="120">
    {%- if section.settings.eyebrow != blank -%}
      <p class="rb-hero__eyebrow" data-reveal>{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="rb-hero__title" data-reveal>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="rb-hero__sub" data-reveal>{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="rb-hero__actions" data-reveal>
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="rb-hero__btn rb-hero__btn--primary" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.phone != blank -%}
        <a
          class="rb-hero__btn rb-hero__btn--secondary"
          href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}"
        >
          {{ section.settings.phone_label | default: section.settings.phone }}
        </a>
      {%- endif -%}
    </div>

    {%- if chips.size > 0 -%}
      <ul class="rb-hero__chips" data-reveal>
        {%- for chip in chips -%}
          {%- assign chip_clean = chip | strip -%}
          {%- if chip_clean != blank -%}
            <li class="rb-hero__chip">{{ chip_clean }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </scroll-reveal>

  <script>
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var s = document.currentScript;
      var hero = s && s.closest('.rb-hero');
      if (!hero || !hero.querySelector('.rb-hero__spotlight')) return;
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect();
        hero.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 100).toFixed(1) + '%');
        hero.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 100).toFixed(1) + '%');
      }, { passive: true });
    })();
  </script>
</div>

{% stylesheet %}
  .rb-hero {
    position: relative;
    display: grid;
    align-items: center;
    justify-items: center;
    min-height: var(--rb-hero-min-h, 86svh);
    overflow: hidden;
    isolation: isolate;
    color: var(--rb-hero-text, #fff);
    text-align: center;
  }

  .rb-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .rb-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rb-hero__img--placeholder {
    background:
      repeating-linear-gradient(135deg, #2b2b2b 0 2px, transparent 2px 22px),
      linear-gradient(160deg, #3a3a3a, #1a1a1a);
  }

  /* Animated, mouse-interactive background shown when no hero image is set */
  .rb-hero__anim {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: radial-gradient(125% 125% at 50% 0%, #242424 0%, #161616 55%, #0d0d0d 100%);
  }

  .rb-hero__aurora,
  .rb-hero__grid,
  .rb-hero__spotlight {
    position: absolute;
    display: block;
  }

  .rb-hero__aurora {
    inset: -25%;
    background:
      radial-gradient(38% 38% at 25% 30%, color-mix(in srgb, var(--rb-accent) 60%, transparent), transparent 70%),
      radial-gradient(34% 34% at 80% 22%, color-mix(in srgb, var(--rb-accent) 32%, transparent), transparent 70%),
      radial-gradient(46% 46% at 62% 88%, rgb(90 90 90 / 0.5), transparent 70%);
    filter: blur(42px) saturate(1.15);
    animation: rb-hero-drift 26s ease-in-out infinite alternate;
    will-change: transform;
  }

  .rb-hero__grid {
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 38%, #000 28%, transparent 80%);
    mask-image: radial-gradient(120% 90% at 50% 38%, #000 28%, transparent 80%);
    animation: rb-hero-pan 38s linear infinite;
  }

  .rb-hero__spotlight {
    inset: 0;
    background: radial-gradient(
      30% 42% at var(--mx, 50%) var(--my, 26%),
      color-mix(in srgb, var(--rb-accent) 50%, transparent),
      transparent 68%
    );
    opacity: 0.7;
    mix-blend-mode: screen;
  }

  @keyframes rb-hero-drift {
    from { transform: translate3d(-3%, -2%, 0) scale(1.05); }
    to   { transform: translate3d(3%, 2%, 0) scale(1.16); }
  }

  @keyframes rb-hero-pan {
    from { background-position: 0 0; }
    to   { background-position: 64px 64px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rb-hero__aurora,
    .rb-hero__grid { animation: none; }
  }

  .rb-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(0 0 0 / calc(var(--rb-overlay, 0.5) + 0.25)),
      rgb(0 0 0 / var(--rb-overlay, 0.5)) 60%,
      rgb(0 0 0 / calc(var(--rb-overlay, 0.5) * 0.6))
    );
  }

  .rb-hero__inner {
    padding-block: clamp(3rem, 8vh, 7rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-md);
    max-width: 60rem;
  }

  .rb-hero__eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--rb-accent);
  }

  .rb-hero__title {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .rb-hero__sub {
    margin: 0 auto;
    font-size: clamp(1.0625rem, 2vw, 1.375rem);
    max-width: 46ch;
    opacity: 0.92;
  }

  .rb-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-sm);
    margin-top: var(--gap-xs);
  }

  .rb-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--padding-lg) var(--padding-2xl);
    border-radius: var(--button-border-radius-primary, 14px);
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .rb-hero__btn:hover {
    transform: translateY(-2px);
  }

  .rb-hero__btn--primary {
    background: var(--rb-accent);
    color: #fff;
  }

  .rb-hero__btn--secondary {
    background: rgb(255 255 255 / 0.1);
    color: var(--rb-hero-text, #fff);
    border: 2px solid currentcolor;
    backdrop-filter: blur(4px);
  }

  .rb-hero__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-xs) var(--gap-md);
    margin: var(--gap-sm) 0 0;
    padding: 0;
    list-style: none;
  }

  .rb-hero__chip {
    position: relative;
    padding-inline-start: 1.25rem;
    font-size: 0.9375rem;
    opacity: 0.92;
  }

  .rb-hero__chip::before {
    content: "✓";
    position: absolute;
    inset-inline-start: 0;
    color: var(--rb-accent);
    font-weight: 800;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Site hero",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pleasant Grove, UT · Licensed & insured"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Concrete that's built to last."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Driveways, patios, RV pads and stamped concrete — poured by a family crew that treats your property like our own."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Get a free estimate"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone button label",
      "default": "Call (385) 210-5983"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(385) 210-5983"
    },
    {
      "type": "textarea",
      "id": "trust_chips",
      "label": "Trust chips (one per line)",
      "default": "Free estimates\nLocally owned\n5-star rated"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "svh",
      "default": 86
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Site hero"
    }
  ]
}
{% endschema %}
