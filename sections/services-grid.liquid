{% comment %}
  Services grid — a responsive grid of concrete services. Each service is a
  local block with an optional image, title, description and link.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: settings.color_palette.foreground
-%}

<div
  class="rb-services section spacing-style"
  style="
    --rb-accent: {{ accent }};
    {% if section.settings.background_color != blank %}--color-background: {{ section.settings.background_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="page-width">
    <div class="rb-section__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- comment -%}
          h2 everywhere except a page that has no hero of its own — the Services
          hub leads with this grid, so its heading is the page's only candidate
          for an h1. Styling comes from the class, so the level changes nothing
          visually.
        {%- endcomment -%}
        {%- assign heading_tag = section.settings.heading_level | default: 'h2' -%}
        <{{ heading_tag }} class="rb-section__title">{{ section.settings.heading }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="rb-section__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <scroll-reveal class="rb-services__grid" data-reveal-stagger="80">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tag = 'div'
          if block.settings.link != blank
            assign tag = 'a'
          endif
        -%}
        <{{ tag }}
          class="rb-service-card"
          data-reveal
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="rb-service-card__media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  widths: '400, 600, 800, 1200',
                  alt: block.settings.image.alt | default: block.settings.title,
                  class: 'rb-service-card__img'
              }}
            </div>
          {%- else -%}
            <div class="rb-service-card__media rb-service-card__media--empty">
              {{ 'collection-1' | placeholder_svg_tag: 'rb-service-card__placeholder' }}
            </div>
          {%- endif -%}
          <div class="rb-service-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="rb-service-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="rb-service-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}
              <span class="rb-service-card__link">{{ block.settings.link_label }} &rarr;</span>
            {%- endif -%}
          </div>
        </{{ tag }}>
      {%- endfor -%}
    </scroll-reveal>
  </div>
</div>

{% stylesheet %}
  .rb-services {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .rb-services__grid {
    display: grid;
    gap: var(--gap-lg);
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 750px) {
    .rb-services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .rb-services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .rb-service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: var(--card-corner-radius, 8px);
    color: inherit;
    text-decoration: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
  }

  a.rb-service-card:hover {
    transform: translateY(-6px);
    border-color: var(--rb-accent);
    box-shadow: 0 18px 40px -24px color-mix(in srgb, var(--color-foreground) 60%, transparent);
  }

  .rb-service-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .rb-service-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  a.rb-service-card:hover .rb-service-card__img {
    transform: scale(1.05);
  }

  .rb-service-card__media--empty .rb-service-card__placeholder {
    width: 100%;
    height: 100%;
    background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  }

  .rb-service-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs);
    padding: var(--padding-xl);
  }

  .rb-service-card__title {
    margin: 0;
  }

  .rb-service-card__text {
    margin: 0;
    opacity: 0.8;
  }

  .rb-service-card__link {
    margin-top: var(--gap-xs);
    font-weight: 700;
    color: var(--rb-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Services grid",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What we pour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Concrete done right, the first time"
    },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use H1 only on a page with no hero above this section. Every page needs exactly one H1.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "From driveways to stamped patios, we handle every step — tear-out, excavation, forming, pouring and finishing."
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Driveways"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Durable, crack-resistant driveways finished to last through Utah winters."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services grid",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
