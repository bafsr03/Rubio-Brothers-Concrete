{% comment %}
  Reel showcase — 1–2 short vertical project videos (reels) that autoplay muted
  and loop, to lift dwell time. Videos are uploaded to Shopify Files and selected
  per block. A poster/preview image protects LCP before the video loads.
{% endcomment %}

<script
  src="{{ 'scroll-reveal.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign accent = section.settings.accent_color | default: '#C42A20'
-%}

<div
  class="rb-reels section spacing-style"
  style="
    --rb-accent: {{ accent }};
    {% if section.settings.background_color != blank %}--color-background: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--color-foreground: {{ section.settings.text_color }};{% endif %}
    {% render 'spacing-style', settings: section.settings %}
  "
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="rb-section__head">
        {%- if section.settings.eyebrow != blank -%}<p class="rb-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="rb-section__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<p class="rb-section__intro">{{ section.settings.intro }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <scroll-reveal class="rb-reels__grid" data-reveal-stagger="100">
      {%- for block in section.blocks -%}
        <figure class="rb-reels__item" data-reveal {{ block.shopify_attributes }}>
          <div class="rb-reels__frame">
            {%- if block.settings.video != blank -%}
              {{
                block.settings.video
                | video_tag:
                  image_size: '500x',
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  preload: 'none',
                  playsinline: true,
                  class: 'rb-reels__video'
              }}
            {%- elsif block.settings.poster != blank -%}
              {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.caption, class: 'rb-reels__video' }}
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag: 'rb-reels__placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.caption != blank -%}
            <figcaption class="rb-reels__caption">{{ block.settings.caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </scroll-reveal>

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="rb-reels__cta">
        <a class="rb-reels__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .rb-reels { background: var(--color-background); color: var(--color-foreground); }

  .rb-reels__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg);
    justify-items: center;
  }
  @media screen and (min-width: 750px) {
    .rb-reels__grid { grid-template-columns: repeat(2, minmax(0, 360px)); justify-content: center; }
  }

  .rb-reels__item { margin: 0; width: 100%; max-width: 360px; }

  .rb-reels__frame {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: var(--card-corner-radius, 12px);
    background: color-mix(in srgb, var(--color-foreground) 8%, var(--color-background));
    box-shadow: 0 20px 50px -28px rgb(0 0 0 / 0.6);
  }
  .rb-reels__video,
  .rb-reels__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .rb-reels__caption {
    margin-top: var(--gap-xs);
    text-align: center;
    font-weight: 600;
    opacity: 0.85;
  }

  .rb-reels__cta { text-align: center; margin-top: var(--gap-xl); }
  .rb-reels__btn {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
    background: var(--rb-accent);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .rb-reels__btn:hover { transform: translateY(-2px); opacity: 0.92; }
{% endstylesheet %}

{% schema %}
{
  "name": "Reel showcase",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch us work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See a pour come together" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Short clips from real Rubio Brothers job sites across Utah County." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#C42A20" },
    { "type": "color", "id": "background_color", "label": "t:settings.background_color", "placeholder": "t:settings.default" },
    { "type": "color", "id": "text_color", "label": "t:settings.text_color", "placeholder": "t:settings.default" },
    { "type": "header", "content": "t:content.padding" },
    { "type": "range", "id": "padding-block-start", "label": "t:settings.top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-inline-start", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (upload to Files)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (fallback)" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reel showcase",
      "blocks": [ { "type": "reel" }, { "type": "reel" } ]
    }
  ]
}
{% endschema %}
