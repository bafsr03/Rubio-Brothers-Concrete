    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Do you pour concrete in Orem?",
            "answer": "<p>Yes. We are based in nearby Pleasant Grove, and on-site estimates in Orem are free.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "How much does a stamped patio cost in Orem?",
            "answer": "<p>Stamped work costs more than a plain broom finish because of the color, stamping and sealing. Use our <a href=\"/pages/estimate\">instant estimator</a> for a plain-concrete ballpark, then we price the finish after a free site visit.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "Can you pour an RV pad beside my house?",
            "answer": "<p>Often, yes. We check width, access and drainage on site, then spec the thickness for your rig. See <a href=\"/pages/rv-pads\">RV pads</a>.</p>"
          }
        }
      },
