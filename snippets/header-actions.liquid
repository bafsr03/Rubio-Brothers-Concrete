{% doc %}
  Header Actions Component

  Service-business build: the cart, account and currency UI have been removed
  (Rubio Brothers sells no products). This renders a click-to-call link built
  from the "Business info" → Phone number theme setting.

  @param {block} [block] - The block object, used for Shopify editor attributes.
  @param {string} [display_style] - 'icon' or 'text'.

  @example
  {% render 'header-actions', section: section %}
{% enddoc %}

{%- liquid
  assign biz_phone = settings.business_phone | default: shop.phone
  assign tel = biz_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign estimate_url = settings.estimate_url | default: '/pages/estimate'
-%}

<header-actions
  class="header-actions--call{% if display_style == 'text' %} header-actions--text{% endif %}"
  {{- block.shopify_attributes -}}
>
  {%- if biz_phone != blank -%}
    <a
      class="header-actions__call header-actions__action"
      href="tel:{{ tel }}"
      aria-label="Call {{ biz_phone }}"
    >
      <span class="header-actions__call-icon svg-wrapper" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </span>
      <span class="header-actions__call-number">{{ biz_phone }}</span>
    </a>
  {%- endif -%}

  <a class="header-actions__estimate" href="{{ estimate_url }}">
    <span class="header-actions__estimate-full">Get a free estimate</span>
    <span class="header-actions__estimate-short">Free estimate</span>
  </a>
</header-actions>

{% stylesheet %}
  header-actions {
    display: flex;
    align-items: center;
    gap: var(--gap-xs, 0.6rem);

    @media screen and (max-width: 749px) {
      justify-self: flex-end;
      gap: var(--gap-2xs, 0.4rem);
    }
  }

  #header-component[data-menu-style='drawer'] header-actions {
    justify-self: flex-end;
  }

  .header-actions__call {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs, 0.4rem);
    min-height: var(--minimum-touch-target, 44px);
    padding-inline: var(--gap-2xs, 0.4rem);
    color: inherit;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .header-actions__call:hover {
    color: var(--rb-accent, #C42A20);
  }

  .header-actions__call-icon {
    display: inline-flex;
    color: var(--rb-accent, #C42A20);
  }

  /* Primary "Get a free estimate" button */
  .header-actions__estimate {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--minimum-touch-target, 44px);
    padding: 0.55rem 1.1rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    color: #fff;
    background: var(--rb-accent, #C42A20);
    border-radius: var(--style-border-radius-buttons-primary, 4px);
    box-shadow: 0 6px 18px -10px color-mix(in srgb, var(--rb-accent, #C42A20) 90%, transparent);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, background 0.2s ease;
  }

  .header-actions__estimate:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--rb-accent, #C42A20) 90%, transparent);
  }

  .header-actions__estimate:active {
    transform: translateY(0);
  }

  .header-actions__estimate-short {
    display: none;
  }

  /* On narrow screens: collapse the call link to its icon and shorten the button */
  @media screen and (max-width: 749px) {
    .header-actions__call-number {
      display: none;
    }

    .header-actions__estimate {
      padding-inline: 0.85rem;
    }

    .header-actions__estimate-full {
      display: none;
    }

    .header-actions__estimate-short {
      display: inline;
    }
  }

  /* Very small phones: hide the call link entirely (sticky call bar covers it) */
  @media screen and (max-width: 429px) {
    .header-actions__call {
      display: none;
    }
  }
{% endstylesheet %}
