{% doc %}
  Renders LocalBusiness (GeneralContractor) JSON-LD for local SEO. Reads values
  from the theme's "Business info" settings, falling back to shop defaults.
{% enddoc %}

{%- liquid
  assign biz_name = settings.business_name | default: shop.name
  assign biz_phone = settings.business_phone
  assign areas = settings.business_areas_served | split: ','

  assign social_urls = ''
  if settings.business_facebook_url != blank
    assign social_urls = social_urls | append: settings.business_facebook_url | append: '||'
  endif
  if settings.business_instagram_url != blank
    assign social_urls = social_urls | append: settings.business_instagram_url | append: '||'
  endif
  if settings.business_yelp_url != blank
    assign social_urls = social_urls | append: settings.business_yelp_url | append: '||'
  endif
  if settings.business_bbb_url != blank
    assign social_urls = social_urls | append: settings.business_bbb_url | append: '||'
  endif
  assign social_list = social_urls | split: '||'

  assign biz_image = settings.seo_share_image | default: settings.logo
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "GeneralContractor",
  "@id": {{ request.origin | append: '/#business' | json }},
  "name": {{ biz_name | json }},
  "url": {{ request.origin | json }},
  {% if settings.logo != blank %}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{% endif %}
  {% if biz_image != blank %}"image": {{ biz_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  {% if biz_phone != blank %}"telephone": {{ biz_phone | json }},{% endif %}
  {%- comment -%}
    "email" is deliberately omitted: it is not used by Google for LocalBusiness
    rich results, but it is a machine-readable address that harvesters scrape
    straight out of the JSON-LD. Phone and address carry the local SEO signal.
  {%- endcomment -%}
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    {% if settings.business_street != blank %}"streetAddress": {{ settings.business_street | json }},{% endif %}
    "addressLocality": {{ settings.business_city | default: 'Pleasant Grove' | json }},
    "addressRegion": {{ settings.business_region | default: 'UT' | json }},
    {% if settings.business_postal != blank %}"postalCode": {{ settings.business_postal | json }},{% endif %}
    "addressCountry": "US"
  },
  {% if settings.business_latitude != blank and settings.business_longitude != blank %}
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ settings.business_latitude | json }},
    "longitude": {{ settings.business_longitude | json }}
  },
  {% endif %}
  "areaServed": [
    {% for area in areas %}
      {
        "@type": "City",
        "name": {{ area | strip | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Concrete services",
    "itemListElement": [
      {% assign svc_list = "Concrete driveways,RV pads,Concrete patios,Stamped decorative concrete,Retaining walls,Sports courts,Concrete tear-out and replacement,Excavation and site prep" | split: ',' %}
      {% for svc in svc_list %}
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": {{ svc | strip | json }}
        }
      }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  },
  {% comment %}
    Google policy: aggregateRating markup must reflect genuine reviews that are
    visible to users on the same page. It is therefore gated behind an explicit
    opt-in (Business info → "Show aggregate rating in SEO markup") and stays off
    until on-site, verifiable review content backs it up.
  {% endcomment %}
  {% if settings.business_show_aggregate_rating and settings.business_rating != blank and settings.business_review_count != blank %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ settings.business_rating | json }},
    "reviewCount": {{ settings.business_review_count | json }},
    "bestRating": "5",
    "worstRating": "1"
  },
  {% endif %}
  {% if social_list.size > 0 %}
  "sameAs": [
    {% for url in social_list %}
      {{ url | strip | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  {% endif %}
  "knowsAbout": [
    "Concrete driveways",
    "Concrete patios",
    "RV pads",
    "Stamped concrete",
    "Concrete tear-out and replacement",
    "Excavation and site prep"
  ]
}
</script>
